# Generated by chezmoi. Do not edit ~/.config/zsh/local.zsh directly.
# Machine-specific interactive zsh setup.

{{ if or (eq .machine "personal-mac") (eq .machine "work") -}}
# OpenCode
export PATH="$HOME/.opencode/bin:$PATH"
export OPENCODE_ENABLE_EXA=1
{{ end }}

{{ if eq .chezmoi.os "darwin" -}}
# Load EXA_API_KEY from macOS Keychain if present.
if command -v security >/dev/null 2>&1; then
  export EXA_API_KEY="$(security find-generic-password -a "$USER" -s EXA_API_KEY -w 2>/dev/null)"
fi
{{ end }}

{{ if eq .machine "personal-mac" -}}
# LM Studio
export PATH="$PATH:$HOME/.lmstudio/bin"
{{ end }}

# Go
export PATH="$HOME/go/bin:$PATH"

# Bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"
[[ -s "$HOME/.bun/_bun" ]] && source "$HOME/.bun/_bun"

# Vite+ bin (https://viteplus.dev)
[[ -f "$HOME/.vite-plus/env" ]] && source "$HOME/.vite-plus/env"

# opam
if command -v opam >/dev/null 2>&1; then
  ZSH_CACHE="${ZDOTDIR:-$HOME/.config/zsh}/.cache"
  mkdir -p "$ZSH_CACHE"

  if [[ -f "$ZSH_CACHE/opam_env" ]]; then
    source "$ZSH_CACHE/opam_env"
  else
    opam env > "$ZSH_CACHE/opam_env"
    source "$ZSH_CACHE/opam_env"
  fi
fi

{{ if eq .machine "personal-mac" -}}
# Use the btca CLI from the better-context repo (dev version).
if [[ -f "$HOME/Projects/better-context/apps/cli/src/index.ts" ]]; then
  btca() {
    bun run "$HOME/Projects/better-context/apps/cli/src/index.ts" "$@"
  }

  btca-global() {
    command btca "$@"
  }
fi
{{ end }}

{{ if eq .machine "work" -}}
# Prefer raw npm/npx on this machine; drop the global pnpm aliases.
unalias npm 2>/dev/null
unalias npx 2>/dev/null

# Personal scripts (e.g. ~/bin/night-man).
export PATH="$HOME/bin:$PATH"

# lumen diff shortcut.
alias ld="lumen diff"

# NVM (only installed on this machine), lazy-loaded.
# Sourcing nvm.sh on every shell costs 1-3s (nvm_auto stats the whole install).
# Instead: put the default node version on PATH now (instant), and only load
# the full nvm machinery the first time `nvm` is actually invoked.
export NVM_DIR="$HOME/.nvm"
if [ -s "$NVM_DIR/nvm.sh" ]; then
  # Add default node version to PATH directly so node/npm/npx work immediately.
  if [ -f "$NVM_DIR/alias/default" ]; then
    _nvm_default="$(< "$NVM_DIR/alias/default")"
    # Resolve a bare major (e.g. "22") to a concrete vX.Y.Z dir.
    if [ -d "$NVM_DIR/versions/node/v$_nvm_default/bin" ]; then
      export PATH="$NVM_DIR/versions/node/v$_nvm_default/bin:$PATH"
    else
      _nvm_default_dir=("$NVM_DIR"/versions/node/v"$_nvm_default"*/bin(N))
      [ -n "$_nvm_default_dir" ] && export PATH="${_nvm_default_dir[-1]}:$PATH"
      unset _nvm_default_dir
    fi
    unset _nvm_default
  fi

  # Lazy stub: load real nvm on first use, then re-exec the requested command.
  nvm() {
    unset -f nvm
    \. "$NVM_DIR/nvm.sh"
    nvm "$@"
  }
fi
{{ end -}}
