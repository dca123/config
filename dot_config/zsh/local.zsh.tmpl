# Generated by chezmoi. Do not edit ~/.config/zsh/local.zsh directly.
# Machine-specific interactive zsh setup.

{{ if or (eq .machine "personal-mac") (eq .machine "work") -}}
# OpenCode
export PATH="$HOME/.opencode/bin:$PATH"
export OPENCODE_ENABLE_EXA=1
{{ end }}

{{ if eq .chezmoi.os "darwin" -}}
# Load EXA_API_KEY from macOS Keychain if present.
if command -v security >/dev/null 2>&1; then
  export EXA_API_KEY="$(security find-generic-password -a "$USER" -s EXA_API_KEY -w 2>/dev/null)"
fi
{{ end }}

{{ if eq .machine "personal-mac" -}}
# LM Studio
export PATH="$PATH:$HOME/.lmstudio/bin"
{{ end }}

# Go
export PATH="$HOME/go/bin:$PATH"

# Bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"
[[ -s "$HOME/.bun/_bun" ]] && source "$HOME/.bun/_bun"

# Vite+ bin (https://viteplus.dev)
[[ -f "$HOME/.vite-plus/env" ]] && source "$HOME/.vite-plus/env"

# opam
if command -v opam >/dev/null 2>&1; then
  ZSH_CACHE="${ZDOTDIR:-$HOME/.config/zsh}/.cache"
  mkdir -p "$ZSH_CACHE"

  if [[ -f "$ZSH_CACHE/opam_env" ]]; then
    source "$ZSH_CACHE/opam_env"
  else
    opam env > "$ZSH_CACHE/opam_env"
    source "$ZSH_CACHE/opam_env"
  fi
fi

{{ if eq .machine "personal-mac" -}}
# Use the btca CLI from the better-context repo (dev version).
if [[ -f "$HOME/Projects/better-context/apps/cli/src/index.ts" ]]; then
  btca() {
    bun run "$HOME/Projects/better-context/apps/cli/src/index.ts" "$@"
  }

  btca-global() {
    command btca "$@"
  }
fi
{{ end -}}
